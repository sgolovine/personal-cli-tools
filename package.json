{
  "name": "docker-manager",
  "version": "1.0.0",
  "description": "An interactive terminal UI for managing Docker resources",
  "type": "module",
  "bin": {
    "docker-manager": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "package": "npm run build && pkg . --target host --output release/docker-manager",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "npm run lint && npm run typecheck"
  },
  "keywords": [
    "docker",
    "ink",
    "cli",
    "tui"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ink-tools/ink-mouse": "^2.1.0",
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@yao-pkg/pkg": "^6.22.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.14",
    "typescript": "^7.0.2"
  }
}
